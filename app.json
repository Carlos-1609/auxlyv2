{
  "expo": {
    "name": "Auxly",
    "slug": "auxly",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/auxly-logo.png",
    "scheme": "auxly",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070808",
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.carlos-aoa.auxly"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/auxly-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/auxly-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/auxly-logo.png",
          "imageWidth": 240
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
